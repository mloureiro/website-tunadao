---
import Icon from '@ui/icons/Icon.astro';
import ResponsiveImage from '@components/ResponsiveImage.astro';

interface Props {
  edition: {
    edition: number;
    year: number;
    date: string;
    venue?: string;
    notes?: string;
    posterUrl?: string;
  };
  editionLabel: string;
  posterPublicId: string | null;
  posterAlt: string;
}

const { edition, editionLabel, posterPublicId, posterAlt } = Astro.props;
const hasPoster = Boolean(edition.posterUrl);
---

<section class:list={['hero', { 'hero--no-poster': !hasPoster }]} aria-labelledby="edition-title">
  <div class="hero-container">
    <div class="hero-content">
      <p class="hero-eyebrow" aria-hidden="true">{editionLabel}</p>
      <h1 id="edition-title" class="hero-title">
        CITADÃO <span class="hero-year">{edition.year}</span>
      </h1>

      <dl class="hero-meta">
        <div class="meta-item">
          <dt class="visually-hidden">Data</dt>
          <dd><Icon name="calendar" size={18} class="meta-icon" /><span>{edition.date}</span></dd>
        </div>
        {
          edition.venue && (
            <div class="meta-item">
              <dt class="visually-hidden">Local</dt>
              <dd>
                <Icon name="map-pin" size={18} class="meta-icon" />
                <span>{edition.venue}</span>
              </dd>
            </div>
          )
        }
      </dl>

      {edition.notes && <p class="hero-notes">{edition.notes}</p>}
    </div>

    {
      hasPoster && (
        <div class="hero-poster">
          <button
            type="button"
            class="poster-button"
            data-poster-url={edition.posterUrl}
            data-poster-alt={posterAlt}
          >
            {posterPublicId ? (
              <ResponsiveImage
                publicId={posterPublicId}
                alt={posterAlt}
                class="poster-image"
                sizes="(max-width: 768px) 70vw, (max-width: 1024px) 40vw, 340px"
                aspectRatio="2/3"
              />
            ) : (
              <img src={edition.posterUrl} alt={posterAlt} class="poster-image" loading="lazy" />
            )}
            <span class="poster-hint" aria-hidden="true">
              <Icon name="zoom-in" size={16} />
            </span>
          </button>
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: var(--space-12) var(--space-6);
    background:
      radial-gradient(120% 140% at 85% 0%, var(--color-secondary-dark) 0%, transparent 55%),
      linear-gradient(135deg, var(--color-surface-brand), var(--color-surface-brand-alt));
    color: var(--color-text-inverted);
    overflow: hidden;
  }

  .hero-container {
    max-width: var(--container-max-width-wide);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-10);
    align-items: center;
  }

  .hero--no-poster .hero-container {
    grid-template-columns: 1fr;
    max-width: 760px;
    text-align: center;
    justify-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
  }

  .hero-eyebrow {
    margin: 0;
    font-family: var(--font-family-heading);
    font-size: var(--font-size-sm);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent-gold);
  }

  .hero-title {
    margin: 0;
    font-family: var(--font-family-heading);
    font-size: clamp(2.75rem, 7vw, 5rem);
    font-weight: 900;
    line-height: 0.92;
    letter-spacing: -0.03em;
  }

  .hero-year {
    display: block;
    font-weight: 800;
    color: rgba(255, 255, 255, 0.72);
  }

  .hero--no-poster .hero-year {
    display: inline;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    margin: var(--space-2) 0 0 0;
  }

  .hero--no-poster .hero-meta {
    justify-content: center;
  }

  .meta-item dd {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    padding: var(--space-2) var(--space-4);
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--radius-full);
    font-size: var(--font-size-base);
    font-weight: 500;
  }

  .meta-icon {
    flex-shrink: 0;
    opacity: 0.85;
  }

  .hero-notes {
    align-self: flex-start;
    margin: var(--space-2) 0 0 0;
    padding: var(--space-2) var(--space-4);
    background: var(--color-secondary-solid);
    border-radius: var(--radius-md);
    font-family: var(--font-family-heading);
    font-size: var(--font-size-sm);
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .hero--no-poster .hero-notes {
    align-self: center;
  }

  /* Poster */
  .hero-poster {
    width: min(340px, 42vw);
  }

  .poster-button {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 18px 50px -12px rgba(0, 0, 0, 0.55);
    transition:
      transform var(--transition-base),
      box-shadow var(--transition-base);
  }

  .poster-button:hover,
  .poster-button:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 26px 60px -12px rgba(0, 0, 0, 0.6);
  }

  .poster-image {
    width: 100%;
    height: auto;
    display: block;
  }

  .poster-hint {
    position: absolute;
    bottom: var(--space-3);
    right: var(--space-3);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    border-radius: var(--radius-full);
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .poster-button:hover .poster-hint,
  .poster-button:focus-visible .poster-hint {
    opacity: 1;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 767.98px) {
    .hero {
      padding: var(--space-10) var(--space-4);
    }

    .hero-container {
      grid-template-columns: 1fr;
      gap: var(--space-8);
      text-align: center;
      justify-items: center;
    }

    .hero-meta {
      justify-content: center;
    }

    .hero-notes {
      align-self: center;
    }

    .hero-year {
      display: inline;
    }

    .hero-poster {
      order: -1;
      width: min(260px, 68vw);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .poster-button {
      transition: none;
    }
    .poster-button:hover,
    .poster-button:focus-visible {
      transform: none;
    }
  }
</style>
